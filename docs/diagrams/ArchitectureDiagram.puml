@startuml
!pragma layout smetana
top to bottom direction

skinparam componentStyle rectangle
skinparam linetype ortho
skinparam Shadowing false
skinparam DefaultTextAlignment center
skinparam ArrowColor #4A5568
skinparam ArrowFontColor #2D3748
skinparam ArrowFontSize 12
skinparam Actor {
    BorderColor #1A202C
    FontColor #1A202C
}
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #4A5568
    FontColor #1A202C
}
skinparam component {
    FontColor #FFFFFF
    BorderColor #FFFFFF
    FontSize 15
}

actor "User" as User

rectangle "HobbyHub" as App {
    component "Main" as Main #606060
    component "UI" as UI #1D8900
    component "Logic" as Logic #3333C4
    component "Model" as Model #9D0012
    component "Storage" as Storage #A38300
    component "Commons" as Commons #6A6ADC

    Main -[hidden]right-> UI
    UI -[hidden]right-> Commons
    UI -[hidden]down-> Logic
    Logic -[hidden]down-> Model
    Model -[hidden]right-> Storage
}

artifact "JSON files" as Files

User --> UI
UI --> Logic
UI --> Model
Logic --> Model
Logic --> Storage
Storage --> Model
Storage --> Files

Main --> UI
Main --> Logic
Main --> Model
Main --> Storage

legend bottom
  |= Notation |= Meaning |
  | A -> B | A uses B |
  | Rectangle | Component |
  | Document | Stored data |
endlegend

@enduml
