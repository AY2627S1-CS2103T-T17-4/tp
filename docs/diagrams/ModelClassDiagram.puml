@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyHobbyHub" as ReadOnlyHobbyHub
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class HobbyHub
Class ModelManager
Class UserPrefs

Class UniqueMemberList
Class UniqueSessionList
Class Member
Class Address
Class Email
Class Name
Class Phone
Class Group
Class HobbyAndSkillPredicate

Class Hobby
Class Skilllevel

Class Session
Class SessionName
Class Date
Class Location

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

HobbyHub .up.|> ReadOnlyHobbyHub

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyHobbyHub
ModelManager -left-> "1" HobbyHub
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

HobbyHub *--> "1" UniqueMemberList
HobbyHub *--> "1" UniqueSessionList
UniqueMemberList --> "~* all" Member
Member *--> Name
Member *--> Phone
Member *--> Email
Member *--> Address
Member *--> "*" Group
Member *--> "*" HobbyAndSkillPredicate
Member --> "*" Session
UniqueSessionList --> "~* all" Session

Session *--> SessionName
Session *--> Date
Session *--> Location

HobbyAndSkillPredicate *--> "1" Hobby
HobbyAndSkillPredicate *--> "1" Skilllevel

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

ModelManager --> "~* filtered" Member
ModelManager --> "~* filtered" Session
@enduml
