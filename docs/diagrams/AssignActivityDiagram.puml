@startuml
!include style.puml
skinparam ActivityFontSize 15
skinparam ArrowFontSize 12
skinparam dpi 150

start
:User enters assign INDEX SESSION_NAME;

if () then ([member list shown])
else ([session list shown])
  :Show "member list required";
  stop
endif

if () then ([INDEX and SESSION_NAME valid])
else ([invalid])
  :Show invalid command format;
  stop
endif

if () then ([INDEX within displayed members])
else ([too large])
  :Show invalid member index;
  stop
endif

if () then ([session with that name exists])
else ([no match, ignoring case])
  :Show "No session named ... exists";
  stop
endif

if () then ([member not yet assigned])
else ([already assigned])
  :Show "already assigned";
  stop
endif

:Replace session with a copy
that includes the member's email;
:Refresh every member's session list;
:Save HobbyHub to the data file;
if () then ([saved])
  :Show success message;
else ([save failed])
  :Restore the HobbyHub copy
  taken before the command;
  :Show save error;
endif
stop
@enduml
