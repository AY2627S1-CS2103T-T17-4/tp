@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam dpi 150
hide footbox

box Logic LOGIC_COLOR_T1
participant "a:AssignCommand" as AssignCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant ":HobbyHub" as HobbyHub MODEL_COLOR
participant "s:Session" as Session MODEL_COLOR
end box

[-> AssignCommand : execute(m)
activate AssignCommand

AssignCommand -> Model : getListState()
activate Model
Model --> AssignCommand : MEMBERS
deactivate Model

AssignCommand -> Model : getFilteredMemberList()
activate Model
Model --> AssignCommand : members
deactivate Model

AssignCommand -> Model : getHobbyHub()
activate Model
Model --> AssignCommand : hobbyHub
deactivate Model

note right of AssignCommand
  Finds session s whose name
  matches, ignoring case, and
  checks the member is not
  already assigned to it.
end note

AssignCommand -> Session : withMember(email)
activate Session
Session --> AssignCommand : updated
deactivate Session

AssignCommand -> Model : setSession(s, updated)
activate Model

Model -> HobbyHub : setSession(s, updated)
activate HobbyHub

HobbyHub -> HobbyHub : refreshMemberSessions()
activate HobbyHub
deactivate HobbyHub

HobbyHub --> Model
deactivate HobbyHub

Model --> AssignCommand
deactivate Model

[<-- AssignCommand : result
deactivate AssignCommand
@enduml
