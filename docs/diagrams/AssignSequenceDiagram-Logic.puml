@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam dpi 150
hide footbox

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":HobbyHubParser" as HobbyHubParser LOGIC_COLOR
participant ":AssignCommandParser" as AssignCommandParser LOGIC_COLOR
participant "a:AssignCommand" as AssignCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute(input)
activate LogicManager

LogicManager -> Model : getListState()
activate Model
Model --> LogicManager : MEMBERS
deactivate Model

LogicManager -> HobbyHubParser : parseCommand(input, MEMBERS)
activate HobbyHubParser

create AssignCommandParser
HobbyHubParser -> AssignCommandParser
activate AssignCommandParser
AssignCommandParser --> HobbyHubParser
deactivate AssignCommandParser

HobbyHubParser -> AssignCommandParser : parse(args)
activate AssignCommandParser

create AssignCommand
AssignCommandParser -> AssignCommand
activate AssignCommand
AssignCommand --> AssignCommandParser
deactivate AssignCommand

AssignCommandParser --> HobbyHubParser : a
deactivate AssignCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
AssignCommandParser -[hidden]-> HobbyHubParser
destroy AssignCommandParser

HobbyHubParser --> LogicManager : a
deactivate HobbyHubParser

LogicManager -> AssignCommand : execute(m)
activate AssignCommand

note right of AssignCommand
  Details in the
  Model diagram below.
end note

AssignCommand --> LogicManager : result
deactivate AssignCommand

[<-- LogicManager : result
deactivate LogicManager
@enduml
